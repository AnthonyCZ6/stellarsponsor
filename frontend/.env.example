# Copia este archivo como .env.local y completa el ID del contrato desplegado.
# Sin NEXT_PUBLIC_CONTRACT_ID la dApp arranca en "modo demo" (sin transacciones reales).

# ID del contrato devuelto por `stellar contract deploy` (empieza con C...)
NEXT_PUBLIC_CONTRACT_ID=

# Red Stellar (por defecto: Testnet)
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
